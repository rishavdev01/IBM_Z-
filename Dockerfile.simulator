# Multi-architecture Dockerfile for Aegis Exchange Simulator (Part 1 reuse)
# Target: IBM LinuxONE (s390x) and x86_64
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    AEGIS_API_URL=http://api:8000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY simulator/requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Create non-root user
RUN useradd -u 1000 -m -s /bin/bash aegis && \
    mkdir -p /app/data && \
    chown -R aegis:aegis /app

COPY simulator/ /app/simulator/

USER aegis

# Default to streaming transactions at 5 txns/sec to API
CMD ["python", "-m", "simulator.main", "stream", "--api-url", "http://api:8000", "--rate", "5", "--duration", "300"]
